__pycache__/
*.pyc
.venv/
data/*.db
# oil.db is a derived artifact (rebuilt from sources). But watch_seen.db is the
# watcher's dedup ledger -- durable memory that CANNOT be re-fetched, so it is
# committed (persists the "what news have we already surfaced" state across runs).
!data/watch_seen.db
# Runtime ops artifacts, regenerated every run (refresh.py / heartbeat.py)
data/refresh_log.csv
data/health_status.json
data/launchd_refresh.log
# engine_read.json is COMMITTED: the light 15-min watcher run reads today's
# amplifier context from it (it does no market fetch of its own). Refreshed by the
# daily full run.
data/engine_read.md
data/playbook.md
# NOTE: data/alert_queue.csv is now COMMITTED (durable memory: the running feed of
# what the watcher has surfaced). data/state/*.csv (situation_log, reads exports)
# are committed too. These are the source of truth the rebuilt oil.db is refilled
# from. Only the big derived DB and the re-rendered views below stay ignored.
# The Daily is re-rendered every refresh; data/digest_sample.html is the committed
# snapshot receipt.
data/digest.html
data/daily.lock
# integrity.py runtime: rotated DB backups and the row-count state
data/backups/
data/integrity_state.json
# Situation dossiers are re-rendered every refresh; data/situations_sample.md is
# the committed snapshot receipt. (situations.yaml IS committed -- it's config.)
data/situations/
# Prediction-market snapshot, regenerated every run; data/predmkt_sample.json is the receipt.
data/predmkt.json
# Corroboration report, regenerated every run; committed sample is the receipt.
data/corroboration.json
# PortWatch snapshot, regenerated every run; committed sample is the receipt.
data/portwatch.json
