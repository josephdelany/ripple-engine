__pycache__/
*.pyc
.venv/
data/*.db
# oil.db is a derived artifact (rebuilt from sources). But watch_seen.db is the
# watcher's dedup ledger -- durable memory that CANNOT be re-fetched, so it is
# committed (persists the "what news have we already surfaced" state across runs).
!data/watch_seen.db
# Runtime ops artifacts, regenerated every run (refresh.py / heartbeat.py)
data/refresh_log.csv
data/health_status.json
data/launchd_refresh.log
data/launchd_desk.log
# engine_read.json is COMMITTED: the light 15-min watcher run reads today's
# amplifier context from it (it does no market fetch of its own). Refreshed by the
# daily full run.
data/engine_read.md
data/playbook.md
# NOTE: data/alert_queue.csv is now COMMITTED (durable memory: the running feed of
# what the watcher has surfaced). data/state/*.csv (situation_log, reads exports)
# are committed too. These are the source of truth the rebuilt oil.db is refilled
# from. Only the big derived DB and the re-rendered views below stay ignored.
# The Daily is re-rendered every refresh; data/digest_sample.html is the committed
# snapshot receipt.
data/digest.html
data/daily.lock
# integrity.py runtime: rotated DB backups and the row-count state
data/backups/
data/integrity_state.json
# Situation dossiers are re-rendered every refresh; data/situations_sample.md is
# the committed snapshot receipt. (situations.yaml IS committed -- it's config.)
data/situations/
# Prediction-market snapshot, regenerated every run; data/predmkt_sample.json is the receipt.
data/predmkt.json
# Corroboration report, regenerated every run; committed sample is the receipt.
data/corroboration.json
# PortWatch snapshot, regenerated every run; committed sample is the receipt.
data/portwatch.json
# Wikipedia attention snapshot, regenerated every run; committed sample is the receipt.
data/wiki_attention.json
# Calibration report, regenerated every run; committed sample is the receipt.
data/corroboration_calibration.json
# Divergence report, regenerated every run; sample committed as receipt.
data/divergence.json
# Criticality report, regenerated every run; sample committed as receipt.
data/criticality.json
# Propagation report, regenerated every run; sample committed as receipt.
data/propagation.json
# Risk-vs-priced read, regenerated every run; sample committed as receipt.
data/gpr_signal.json
# Analogue forecast, regenerated every run; sample committed as receipt.
data/analogue.json
# Backtest + engine calibration, regenerated each run; samples committed.
data/backtest_analogue.json
data/forecast_calibration.json
# Per-situation conflict intensity, regenerated each run.
data/conflict_intensity.json
# OPEC fiscal-stress board, regenerated each run; sample committed.
data/breakevens.json
# Story live state (regenerated); yaml + sample are committed.
data/stories/*.state.json
# calibration + registered-run receipts are regenerated/committed as appropriate.
data/calibration.json
# V-Q1 quarterly frozen DB snapshots: large derived DB copies. data/vintage_check.txt IS the
# committed receipt; the .db.gz vintages themselves are not source.
data/vintages/
# Workbench notes: Joe's private analysis drafts + exports (local writing pane).
# Personal, never source -- the tool writes them; they never belong in the repo.
data/notes/

# Reader cache: model proposals keyed by content hash (derived; a story is re-read if absent)
data/reader/

# World-state panel caches (PATH Step 2): free downloads are rebuilt by the loaders; local/ holds
# licence-restricted files (Polity/CSP, SIPRI, GSDB, NYT, EI 2026) that are never committed.
data/state/raw/
data/state/local/*
!data/state/local/README.md

# 2026-09-02 (session A): runtime + cache artefacts that must never be committed
data/integrity_check.txt
data/last_run.json
data/oil.db-shm
data/oil.db-wal
data/state/health_alert_seen.txt
# UCDP GED raw pull (CC BY, 40 MB, rebuilt by fetch_ucdp.py --refresh); extractor working files
data/cache/
data/extract/
# keys and tokens live here (SESSION_CHARTER.md §6), never in the repo
tools/config.json
*.key
*.token
# jsdom for the app render check (tests/test_app_render.py): npm install --prefix tools jsdom
tools/node_modules/
tools/package*.json
